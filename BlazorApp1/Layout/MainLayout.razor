@inherits LayoutComponentBase

@using BlazorApp1.Logic
@using Microsoft.JSInterop
@using System.Text.Json

@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page">

    <main>

        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/"
               target="_blank">
                About
            </a>
        </div>

        <article class="content px-4">

            @if (authChecked)
            {
                @Body
            }
            else
            {
                <div class="auth-loading">
                    Kontrollerer login...
                </div>
            }

        </article>

    </main>

    @if (authChecked && !IsLoginPage())
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

</div>

@code {
    private bool authChecked = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        string currentPage =
            Navigation.ToBaseRelativePath(Navigation.Uri);

        // Login må åbnes uden login
        if (currentPage.StartsWith(
                "login",
                StringComparison.OrdinalIgnoreCase))
        {
            authChecked = true;

            StateHasChanged();

            return;
        }

        string? savedUser =
            await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "loggedInUser"
            );

        if (string.IsNullOrEmpty(savedUser))
        {
            Navigation.NavigateTo("/login", true);

            return;
        }

        authChecked = true;

        StateHasChanged();
    }

    private bool IsLoginPage()
    {
        string currentPage =
            Navigation.ToBaseRelativePath(Navigation.Uri);

        return currentPage.StartsWith(
            "login",
            StringComparison.OrdinalIgnoreCase
        );
    }
}