@page "/mydices"
@using BlazorApp1.Logic
@using Microsoft.JSInterop
@inject IJSRuntime JS

<h1>My Dices</h1>

<p>Vælg antal terninger:</p>

<select @bind="numberOfDice">
    <option value="1">1</option>
    <option value="2">2</option>
    <option value="3">3</option>
    <option value="4">4</option>
    <option value="5">5</option>
    <option value="6">6</option>
</select>

<button class="btn btn-primary" @onclick="RollDice">
    Kast terninger
</button>

<hr />

<div>
    @foreach (Die die in cup.Dice)
    {
        <img src="@GetDiceImage(die.Value)"
             alt="Terning med @die.Value øjne"
             width="100" />
    }
</div>

@code {
    private int numberOfDice = 2;

    private DieCup cup = new DieCup();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string? savedNumber =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "numberOfDice"
                );

            string? savedValues =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "diceValues"
                );

            if (int.TryParse(savedNumber, out int amount))
            {
                numberOfDice = amount;
                cup.SetNumberOfDice(numberOfDice);
            }

            if (!string.IsNullOrEmpty(savedValues))
            {
                string[] values = savedValues.Split(',');

                for (int i = 0; i < values.Length && i < cup.Dice.Count; i++)
                {
                    if (int.TryParse(values[i], out int value))
                    {
                        cup.Dice[i].SetValue(value);
                    }
                }
            }

            StateHasChanged();
        }
    }

    private async Task RollDice()
    {
        cup.SetNumberOfDice(numberOfDice);

        cup.Roll();

        await SaveDice();
    }

    private async Task SaveDice()
    {
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "numberOfDice",
            numberOfDice
        );

        string values =
            string.Join(",", cup.Dice.Select(die => die.Value));

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "diceValues",
            values
        );
    }

    private string GetDiceImage(int value)
    {
        return $"images/dice/dice{value}.png";
    }
}