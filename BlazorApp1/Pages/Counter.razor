@page "/counter"
@inject IJSRuntime JS
<PageTitle>Counter</PageTitle>

<div class="counter-page">

    <div class="counter-header">
        <h1>Counter</h1>
        <p>Tæl op og få et tilfældigt tal undervejs.</p>
    </div>

    <div class="counter-card">

        <span class="counter-label">CURRENT COUNT</span>

        <div class="counter-number">
            @currentCount
        </div>

        @if (currentCount > 0)
        {
            <div class="random-section">
                <span>Tilfældigt tal</span>

                <div class="random-number"
                     style="color: @GetNumberColor()">
                    @randomNumber
                </div>
            </div>
        }

        @if (randomNumber == birthdayDay && currentCount > 0)
        {
            <div class="birthday-message">
                Du ramte min fødselsdag!
            </div>
        }

        <div class="counter-actions">
            <button class="count-button" @onclick="IncrementCount">
                + Tæl op
            </button>

            <button class="reset-button" @onclick="ResetCount">
                ↻ Reset
            </button>
        </div>

    </div>

</div>

@code {
    private int currentCount = 0;
    private int randomNumber = 0;
    private int birthdayDay = 4;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string? savedCount =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "counterValue"
                );

            string? savedRandom =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "randomNumber"
                );

            if (int.TryParse(savedCount, out int count))
            {
                currentCount = count;
            }

            if (int.TryParse(savedRandom, out int random))
            {
                randomNumber = random;
            }

            StateHasChanged();
        }
    }

    private async Task IncrementCount()
    {
        currentCount++;

        randomNumber =
            Random.Shared.Next(1, currentCount + 1);

        await SaveToLocalStorage();
    }

    private async Task ResetCount()
    {
        currentCount = 0;
        randomNumber = 0;

        await SaveToLocalStorage();
    }

    private async Task SaveToLocalStorage()
    {
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "counterValue",
            currentCount
        );

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "randomNumber",
            randomNumber
        );
    }

    private string GetNumberColor()
    {
        if (randomNumber == birthdayDay)
        {
            return "red";
        }

        return "black";
    }
}