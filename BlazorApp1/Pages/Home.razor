@page "/"

<PageTitle>Home</PageTitle>

<div class="home-page">

    <section class="hero">

        <div class="hero-content">
            <span class="eyebrow">MIN BLAZOR LEGEPLADS</span>

            <h1>
                Velkommen til min
                <span>projektverden</span>
            </h1>

            <p>
                Her bygger jeg små firmaer, spil, værktøjer,
                eksperimenter og opgaver i Blazor og C#.
            </p>

            <div class="hero-actions">
                <a class="primary-action" href="/shop">
                    Se mine projekter
                </a>

                <a class="secondary-action" href="/todo">
                    Åbn Todo
                </a>
            </div>
        </div>

        <div class="hero-visual">

            <div class="floating-card card-one">
                <div class="card-icon">🎲</div>
                <strong>Spil</strong>
                <span>Terninger og små lege</span>
            </div>

            <div class="floating-card card-two">
                <div class="card-icon">🛍</div>
                <strong>Mini-firmaer</strong>
                <span>Shop og lagerstyring</span>
            </div>

            <div class="floating-card card-three">
                <div class="card-icon">☁</div>
                <strong>Eksperimenter</strong>
                <span>Weather og data</span>
            </div>

        </div>

    </section>

    <section class="projects-section">

        <div class="section-heading">
            <div>
                <span class="eyebrow">UDFORSK</span>
                <h2>Mine små projekter</h2>
            </div>

            <p>
                Hver side er et lille eksperiment med Blazor,
                C#, logik og design.
            </p>
        </div>

        <div class="project-grid">

            <a class="project-card" href="/counter">
                <div class="project-icon blue">⏱</div>

                <div>
                    <h3>Counter</h3>
                    <p>
                        En interaktiv counter med random tal,
                        fødselsdag og localStorage.
                    </p>
                </div>

                <span class="project-arrow">→</span>
            </a>

            <a class="project-card" href="/weather">
                <div class="project-icon sky">☁</div>

                <div>
                    <h3>Weather</h3>
                    <p>
                        Tilfældige vejrudsigter, byer,
                        temperaturer og filtrering.
                    </p>
                </div>

                <span class="project-arrow">→</span>
            </a>

            <a class="project-card" href="/mydices">
                <div class="project-icon purple">🎲</div>

                <div>
                    <h3>MyDices</h3>
                    <p>
                        Kast terninger, vælg antal og
                        gem resultatet i browseren.
                    </p>
                </div>

                <span class="project-arrow">→</span>
            </a>

            <a class="project-card" href="/shop">
                <div class="project-icon green">🛍</div>

                <div>
                    <h3>Shop</h3>
                    <p>
                        Et lille firma med varer,
                        lagerstatus og kapital.
                    </p>
                </div>

                <span class="project-arrow">→</span>
            </a>

            <a class="project-card" href="/shopcolors">
                <div class="project-icon orange">🎨</div>

                <div>
                    <h3>Farvefilter</h3>
                    <p>
                        Filtrer shop-varerne efter
                        flere farver på samme tid.
                    </p>
                </div>

                <span class="project-arrow">→</span>
            </a>

            <a class="project-card" href="/todo">
                <div class="project-icon red">✓</div>

                <div>
                    <h3>Todo</h3>
                    <p>
                        Hold styr på opgaver med status,
                        sletning og localStorage.
                    </p>
                </div>

                <span class="project-arrow">→</span>
            </a>

        </div>

    </section>

    <section class="bottom-banner">

        <div>
            <span class="eyebrow light">UNDER UDVIKLING</span>

            <h2>
                Der kommer hele tiden nye små idéer til.
            </h2>

            <p>
                Nogle er seriøse. Nogle er spil.
                Nogle er bare lavet for at se, om jeg kan.
            </p>
        </div>

        <div class="banner-icon">
            &lt;/&gt;
        </div>

    </section>

</div>