@page "/productlist"

@using Core
@using BlazorApp1.Logic
@using BlazorApp1.Components
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Produktliste</PageTitle>

<div class="product-page">

    <div class="product-header">

        <div>
            <span class="product-eyebrow">PRODUKTADMINISTRATION</span>
            <h1>Produktliste</h1>
            <p>Se og administrer dine oprettede produkter.</p>
        </div>

        @if (loggedInUser?.Role == "admin")
        {
            <button class="add-product-button"
                    @onclick="AddProduct">
                + Tilføj produkt
            </button>
        }

    </div>

    @if (products.Count > 0)
    {
        <div class="product-list-section">

            <div class="list-header">

                <div>
                    <span class="product-eyebrow">PRODUKTLISTE</span>
                    <h2>Oprettede produkter</h2>
                </div>

                <span class="product-count">
                    @products.Count produkter
                </span>

            </div>

            <div class="product-table-card">

                <table class="product-table">

                    <thead>
                        <tr>
                            <th>Navn</th>
                            <th>Pris</th>
                            <th>Stock</th>
                            <th>Kategori</th>
                            <th>Published</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (Product product in products)
                    {
                        <ProductComponent Product="product"
                                          IsAdmin="@(loggedInUser?.Role == "admin")"
                                          OnDelete="ConfirmDelete" />
                    }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <p>Der er endnu ikke oprettet nogen produkter.</p>
    }

</div>

@code {

    private User? loggedInUser;

    private List<Product> products = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string? savedUser =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "loggedInUser"
                );

            if (string.IsNullOrEmpty(savedUser))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            loggedInUser =
                JsonSerializer.Deserialize<User>(savedUser);

            await LoadProducts();

            StateHasChanged();
        }
    }

    private async Task LoadProducts()
    {
        Product[]? apiProducts =
            await Http.GetFromJsonAsync<Product[]>(
                "http://localhost:5186/api/product"
            );

        products = apiProducts?.ToList()
                   ?? new List<Product>();

        // Almindelige brugere må kun se publicerede produkter
        if (loggedInUser?.Role != "admin")
        {
            products = products
                .Where(product => product.IsPublished)
                .ToList();
        }
    }

    private void AddProduct()
    {
        Navigation.NavigateTo("/product");
    }

    private async Task ConfirmDelete(Product product)
    {
        // Kun admin må slette
        if (loggedInUser?.Role != "admin")
        {
            return;
        }

        bool confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Vil du slette {product.Name}?"
            );

        if (!confirmed)
        {
            return;
        }

        HttpResponseMessage response =
            await Http.DeleteAsync(
                $"http://localhost:5186/api/product/{product.Id}"
            );

        if (response.IsSuccessStatusCode)
        {
            await LoadProducts();

            StateHasChanged();
        }
    }
}