@page "/search"

@using System.Net.Http.Json
@inject HttpClient Http

<h3>SearchPage</h3>

<input @bind="searchText"
       placeholder="Indtast et ord..." />

<button @onclick="SearchStartsWith">
    Starts With
</button>

<button @onclick="SearchContains">
    Contains
</button>

<button @onclick="SearchDistanceOne">
    Distance 1
</button>

@if (!string.IsNullOrEmpty(searchDescription) && viewedWords != null)
{
    <p>
        Herunder er @viewedWords.Length ord som @searchDescription
    </p>
}

@if (viewedWords != null)
{
    <ul>
        @foreach (var w in viewedWords.Take(visibleCount))
        {
            <li>@w</li>
        }
    </ul>

    @if (viewedWords.Length > visibleCount)
    {
        <button @onclick="ShowMore">
            Flere...
        </button>
    }
}
else
{
    <p>waiting for words to be loaded...</p>
}

@code {
    private string[]? viewedWords;

    private string searchText = "";

    private string searchDescription = "";

    private int visibleCount = 10;

    protected override async Task OnInitializedAsync()
    {
        viewedWords =
            await Http.GetFromJsonAsync<string[]>(
                "http://localhost:5186/word/100"
            );
    }

    private async Task SearchStartsWith()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return;
        }

        visibleCount = 10;

        string search =
            Uri.EscapeDataString(searchText.Trim());
  // gør søgeteksten sikker at putte ind i en URL. Det bliver især nyttigt, hvis teksten indeholder mellemrum eller særlige tegn.      
        
  
  
        viewedWords =
            await Http.GetFromJsonAsync<string[]>(
                $"http://localhost:5186/word/startswith/{search}"
            );

        searchDescription =
            $"starter med \"{searchText}\"";
    }

    private async Task SearchContains()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return;
        }

        visibleCount = 10;

        string search =
            Uri.EscapeDataString(searchText.Trim());

        viewedWords =
            await Http.GetFromJsonAsync<string[]>(
                $"http://localhost:5186/word/contains/{search}"
            );

        searchDescription =
            $"indeholder \"{searchText}\"";
    }

    private async Task SearchDistanceOne()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return;
        }

        visibleCount = 10;

        string search =
            Uri.EscapeDataString(searchText.Trim());

        viewedWords =
            await Http.GetFromJsonAsync<string[]>(
                $"http://localhost:5186/word/distanceone/{search}"
            );

        searchDescription =
            $"har distance 1 til \"{searchText}\"";
    }

    private void ShowMore()
    {
        visibleCount += 10;
    }
}