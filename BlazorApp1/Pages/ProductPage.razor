@page "/product"

@using Core
@using BlazorApp1.Logic
@using BlazorApp1.Components
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Produkter</PageTitle>

<TimeComponent />

<div class="product-page">

    <div class="product-header">

        <div>
            <span class="product-eyebrow">
                PRODUKTADMINISTRATION
            </span>

            <h1>Tilføj produkt</h1>

            <p>
                Opret et nyt produkt og gem det på serveren.
            </p>
        </div>

        <button class="list-button"
                @onclick="GoToProductList">
            Se produktliste
        </button>

    </div>

    <div class="product-form-card">

        <EditForm Model="@aProduct"
                  OnValidSubmit="@HandleValidSubmit">

            <DataAnnotationsValidator />

            <ValidationSummary />

            <div class="form-group">
                <label>Navn</label>

                <InputText class="form-control"
                           @bind-Value="aProduct.Name" />

                <ValidationMessage
                    For="@(() => aProduct.Name)" />
            </div>

            <div class="form-group">
                <label>Pris</label>

                <InputNumber class="form-control"
                             @bind-Value="aProduct.Price" />

                <ValidationMessage
                    For="@(() => aProduct.Price)" />
            </div>

            <div class="form-group">
                <label>Stock</label>

                <InputNumber class="form-control"
                             @bind-Value="aProduct.Stock" />

                <ValidationMessage
                    For="@(() => aProduct.Stock)" />
            </div>

            <div class="form-group">
                <label>Kategori</label>

                <InputSelect class="form-control"
                             @bind-Value="aProduct.Category">

                    <option value="">
                        Vælg kategori
                    </option>

                    <option value="computer">
                        Computer
                    </option>

                    <option value="audio">
                        Audio
                    </option>

                    <option value="video">
                        Video
                    </option>

                    <option value="memory">
                        Memory
                    </option>

                    <option value="other">
                        Andet
                    </option>

                </InputSelect>

                <ValidationMessage
                    For="@(() => aProduct.Category)" />
            </div>

            <div class="form-group">
                <label>Dato</label>

                <InputDate class="form-control"
                           @bind-Value="aProduct.PublishedDate" />
            </div>

            <div class="form-group">
                <label>Beskrivelse</label>

                <InputTextArea class="form-control"
                               @bind-Value="aProduct.Description" />

                <ValidationMessage
                    For="@(() => aProduct.Description)" />
            </div>

            <div class="form-check">
                <InputCheckbox class="form-check-input"
                               @bind-Value="aProduct.IsPublished" />

                <label>
                    Published
                </label>
            </div>

            <div class="form-actions">

                <button type="submit"
                        class="save-button">
                    Gem produkt
                </button>

                <button type="button"
                        class="reset-button"
                        @onclick="ResetForm">
                    Nulstil
                </button>

            </div>

        </EditForm>

        @if (!string.IsNullOrEmpty(status))
        {
            <div class="product-status">
                @status
            </div>
        }

    </div>

</div>

@code {
    private Product aProduct = new();

    private string status = "";

    private User? loggedInUser;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            string? savedUser =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "loggedInUser"
                );

            if (string.IsNullOrEmpty(savedUser))
            {
                Navigation.NavigateTo("/login", true);

                return;
            }

            loggedInUser =
                JsonSerializer.Deserialize<User>(savedUser);

            if (loggedInUser?.Role != "admin")
            {
                Navigation.NavigateTo(
                    "/productlist",
                    true
                );

                return;
            }

            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        HttpResponseMessage response =
            await Http.PostAsJsonAsync(
                "api/product",
                aProduct
            );

        if (response.IsSuccessStatusCode)
        {
            status = "Produktet blev gemt.";

            aProduct = new Product();
        }
        else
        {
            status =
                "Der opstod en fejl ved gemning af produktet.";
        }
    }

    private void ResetForm()
    {
        aProduct = new Product();

        status = "";
    }

    private void GoToProductList()
    {
        Navigation.NavigateTo("/productlist");
    }
}