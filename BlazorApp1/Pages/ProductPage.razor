@page "/product"

@using Core
@using BlazorApp1.Logic
@using BlazorApp1.Components
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Produkter</PageTitle>

<TimeComponent />

<div class="product-page">

    <div class="product-header">
        <div>
            <span class="product-eyebrow">PRODUKTADMINISTRATION</span>
            <h1>Tilføj produkt</h1>
            <p>Opret og administrer produkter i dit lille produktkatalog.</p>

            <button class="btn btn-secondary"
                    @onclick="GoToProductList">
                Se produktliste
            </button>
        </div>

        <div class="product-header-icon">
            📦
        </div>
    </div>

    <div class="product-form-card">

        <EditForm Model="@aProduct" OnValidSubmit="@HandleValidSubmit">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="Name">Navn</label>

                <InputText id="Name"
                           @bind-Value="aProduct.Name"
                           class="form-control" />
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label for="Price">Pris</label>

                    <InputNumber id="Price"
                                 @bind-Value="aProduct.Price"
                                 class="form-control" />
                </div>

                <div class="form-group">
                    <label for="Stock">Stock</label>

                    <InputNumber id="Stock"
                                 @bind-Value="aProduct.Stock"
                                 class="form-control" />

                    <ValidationMessage For="@(() => aProduct.Stock)" />
                </div>

                <div class="form-group">
                    <label for="Category">Kategori</label>

                    <InputSelect id="Category"
                                 @bind-Value="aProduct.Category"
                                 class="form-control">

                        <option value="">-- Vælg kategori --</option>
                        <option value="computer">Computer</option>
                        <option value="audio">Audio</option>
                        <option value="video">Video</option>
                        <option value="memory">Memory</option>
                        <option value="other">Other</option>

                    </InputSelect>

                    <ValidationMessage For="@(() => aProduct.Category)" />
                </div>

                <div class="form-group">
                    <label for="PublishedDate">Udgivelsesdato</label>

                    <InputDate id="PublishedDate"
                               @bind-Value="aProduct.PublishedDate"
                               class="form-control" />
                </div>

            </div>

            <div class="form-group">
                <label for="Description">Beskrivelse</label>

                <InputTextArea id="Description"
                               @bind-Value="aProduct.Description"
                               class="form-control description-box" />
            </div>

            <div class="form-group checkbox-group">
                <label>
                    <InputCheckbox @bind-Value="aProduct.IsPublished"
                                   class="form-check-input" />
                    Is Published
                </label>
            </div>

            <div class="form-actions">

                <button type="submit"
                        class="submit-button">
                    + Tilføj produkt
                </button>

                <button type="button"
                        class="reset-button"
                        @onclick="ResetForm">
                    ↻ Reset
                </button>

            </div>

        </EditForm>

        @if (!string.IsNullOrEmpty(status))
        {
            <div class="status-message">
                @status
            </div>
        }

    </div>

</div>

@code {
    private Product aProduct = new();

    private string status = "";

    private User? loggedInUser;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string? savedUser =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "loggedInUser"
                );

            if (string.IsNullOrEmpty(savedUser))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            loggedInUser =
                JsonSerializer.Deserialize<User>(savedUser);

            // Kun admin må oprette produkter
            if (loggedInUser?.Role != "admin")
            {
                Navigation.NavigateTo("/productlist", true);
                return;
            }

            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        HttpResponseMessage response =
            await Http.PostAsJsonAsync(
                "http://localhost:5186/api/product",
                aProduct
            );

        if (response.IsSuccessStatusCode)
        {
            status = "Produktet blev gemt.";

            aProduct = new Product();
        }
        else
        {
            status = "Der opstod en fejl ved gemning af produktet.";
        }
    }

    private void ResetForm()
    {
        aProduct = new Product();

        status = "";
    }

    private void GoToProductList()
    {
        Navigation.NavigateTo("/productlist");
    }
}