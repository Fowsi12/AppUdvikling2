@page "/login"

@using BlazorApp1.Logic
@using Microsoft.JSInterop
@using System.Text.Json

@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Log ind</PageTitle>

<div class="login-page">

    <div class="login-card">

        <div class="login-icon">
            🔐
        </div>

        <div class="login-header">
            <span class="login-eyebrow">VELKOMMEN TILBAGE</span>

            <h1>Log ind</h1>

            <p>
                Log ind for at få adgang til produkter og produktlisten.
            </p>
        </div>

        <div class="login-form">

            <div class="form-group">
                <label>Brugernavn</label>

                <InputText @bind-Value="username"
                           class="form-control"
                           placeholder="Indtast brugernavn" />
            </div>

            <div class="form-group">
                <label>Password</label>

                <InputText type="password"
                           @bind-Value="password"
                           class="form-control"
                           placeholder="Indtast password" />
            </div>

            <button class="login-button"
                    @onclick="Login">
                Log ind
            </button>

        </div>

        @if (!string.IsNullOrEmpty(errorText))
        {
            <div class="error-message">
                ⚠ @errorText
            </div>
        }

        <div class="demo-users">
            <strong>Test-login</strong>

            <span>Admin: admin / admin123</span>
            <span>Bruger: user / user123</span>
        </div>

    </div>

</div>

@code {

    private string username = "";
    private string password = "";

    private string errorText = "";

    private async Task Login()
    {
        string? savedUsers =
            await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "users"
            );

        List<User> users;

        if (string.IsNullOrEmpty(savedUsers))
        {
            users = CreateDefaultUsers();

            await SaveUsers(users);
        }
        else
        {
            users =
                JsonSerializer.Deserialize<List<User>>(savedUsers)
                ?? new List<User>();
        }

        User? loggedInUser = users.FirstOrDefault(user =>
            user.Username.Equals(
                username,
                StringComparison.OrdinalIgnoreCase)
            &&
            user.Password == password
        );

        if (loggedInUser != null)
        {
            User sessionUser = new User
            {
                Username = loggedInUser.Username,
                Role = loggedInUser.Role
            };

            string json =
                JsonSerializer.Serialize(sessionUser);

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "loggedInUser",
                json
            );

            Navigation.NavigateTo("/productlist", true);
        }
        else
        {
            errorText =
                "Forkert brugernavn eller password.";
        }
    }
    
    private List<User> CreateDefaultUsers()
    {
        return new List<User>
        {
            new User
            {
                Username = "admin",
                Password = "admin123",
                Role = "admin"
            },

            new User
            {
                Username = "user",
                Password = "user123",
                Role = "user"
            }
        };
    }
    private async Task SaveUsers(List<User> users)
    {
        string json =
            JsonSerializer.Serialize(users);

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "users",
            json
        );
    }
}