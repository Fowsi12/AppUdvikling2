@page "/weather"

@using Core 
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Weather</PageTitle>

<div class="weather-page">

    <div class="weather-header">
        <div>
            <h1>Weather</h1>
            <p>Tilfældige vejrudsigter fra forskellige danske byer.</p>
        </div>

        <div class="weather-header-icon">
            ☁
        </div>
    </div>

    <div class="weather-toolbar">

        <div class="toolbar-section">
            <span class="toolbar-title">Filtrer vejr</span>

            <div class="toolbar-buttons">
                <button class="filter-button all" @onclick="ShowAll">
                    Alle
                </button>

                <button class="filter-button cold" @onclick="ShowCold">
                    ❄ Kolde
                </button>

                <button class="filter-button warm" @onclick="ShowWarm">
                    ☀ Varme
                </button>
            </div>
        </div>

        <div class="toolbar-section">
            <span class="toolbar-title">Antal vejrudsigter</span>

            <div class="toolbar-buttons">
                <button class="amount-button more" @onclick="ShowMore">
                    + Vis flere
                </button>

                <button class="amount-button less"
                        @onclick="ShowLess"
                        disabled="@(numberToShow <= 5)">
                    − Vis færre
                </button>
            </div>
        </div>

    </div>

    <div class="weather-table-card">

        <table class="weather-table">
            <thead>
                <tr>
                    <th>Dato</th>
                    <th>By</th>
                    <th>Temp. (C)</th>
                    <th>Temp. (F)</th>
                    <th>Vejr</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var forecast in GetForecasts())
                {
                    <tr>
                        <td class="date-cell">
                            @forecast.Date.ToShortDateString()
                        </td>

                        <td>
                            <span class="location-badge">
                                @forecast.Location
                            </span>
                        </td>

                        <td>
                            @if (forecast.TemperatureC <= 10)
                            {
                                <span class="temperature cold-temperature">
                                    @(forecast.TemperatureC) °C
                                </span>
                            }
                            else
                            {
                                <span class="temperature warm-temperature">
                                    @(forecast.TemperatureC) °C
                                </span>
                            }
                        </td>

                        <td>
                            @(forecast.TemperatureF) °F
                        </td>

                        <td>
                            @forecast.Summary
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>

@code {
    private List<WeatherForecast> forecasts = new();

    private int numberToShow = 10;

    private string filter = "Alle";

    protected override async Task OnInitializedAsync()
    {
        WeatherForecast[]? apiForecasts =
            await Http.GetFromJsonAsync<WeatherForecast[]>(
                "http://localhost:5186/Api/vejr/random/20"
            );

        forecasts = apiForecasts?.ToList()
                    ?? new List<WeatherForecast>();
    }

    private IEnumerable<WeatherForecast> GetForecasts()
    {
        IEnumerable<WeatherForecast> result = forecasts;

        if (filter == "Kolde")
        {
            result = result.Where(
                f => f.TemperatureC <= 10);
        }

        if (filter == "Varme")
        {
            result = result.Where(
                f => f.TemperatureC > 10);
        }

        return result.Take(numberToShow);
    }

    private void ShowAll()
    {
        filter = "Alle";
    }

    private void ShowCold()
    {
        filter = "Kolde";
    }

    private void ShowWarm()
    {
        filter = "Varme";
    }

    private void ShowMore()
    {
        if (numberToShow < forecasts.Count)
        {
            numberToShow += 5;
        }
    }

    private void ShowLess()
    {
        if (numberToShow > 5)
        {
            numberToShow -= 5;
        }
    }
}